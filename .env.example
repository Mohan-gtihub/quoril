VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_anon_key

# Voice task agent (NVIDIA OpenAI-compatible API).
# Inlined into the renderer build at compile time; also read by the Electron
# main process for local dev. Leave blank to disable the voice feature.
VITE_NVIDIA_API_KEY=your_nvidia_api_key
# Optional model override (defaults to minimaxai/minimax-m3).
VITE_NVIDIA_MODEL=minimaxai/minimax-m3
# Used only as a dev fallback by the Electron main process if the renderer key
# is absent. Safe to leave equal to VITE_NVIDIA_API_KEY.
NVIDIA_API_KEY=your_nvidia_api_key

# Speech-to-text for voice task capture (Groq, OpenAI-compatible Whisper).
# Get a free key at https://console.groq.com. The Electron main process reads
# GROQ_API_KEY; the renderer falls back to VITE_GROQ_API_KEY only when run in a
# plain browser. Leave blank to keep voice capture disabled in the desktop app.
GROQ_API_KEY=your_groq_api_key
VITE_GROQ_API_KEY=your_groq_api_key
# Optional STT model override (defaults to whisper-large-v3-turbo).
VITE_GROQ_STT_MODEL=whisper-large-v3-turbo
